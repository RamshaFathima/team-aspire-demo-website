{
  "name": "aspire-backend",
  "version": "1.0.0",
  "description": "Team Aspire NGO platform — service-based backend (Express + TypeScript + Sequelize + Redis)",
  "main": "server.js",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "nodemon --config nodemon.json src-typescript/server.ts",
    "start": "ts-node --transpile-only src-typescript/server.ts",
    "keys:generate": "node scripts/generate-keys.cjs",
    "db:seed": "ts-node --transpile-only src-typescript/seed.ts",
    "build": "tsc",
    "preview": "node dist/server.js",
    "prettier": "prettier --write \"src-typescript/**/*.ts\"",
    "lint": "eslint"
  },
  "author": "Team Aspire",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.4.1",
    "joi": "^17.11.0",
    "joi-to-swagger": "^6.2.0",
    "jose": "^5.9.6",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.1",
    "sequelize": "^6.35.2",
    "sequelize-typescript": "^2.1.6",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.0.2",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.8.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
