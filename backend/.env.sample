# ─── Runtime ──────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aspire
DB_USER=aspire
DB_PASS=password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_FILE=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── JWT / JWKS (RS256) ───────────────────────────────────────────────────────
# Generate with: pnpm keys:generate  (writes keys/private.pem)
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_PATH=keys/private.pem

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_TRANSPORT=stdout
